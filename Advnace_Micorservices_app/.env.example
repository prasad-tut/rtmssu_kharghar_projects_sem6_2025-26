# Database Configuration
DB_URL=jdbc:postgresql://your-database-host:port/database-name?sslmode=require
DB_USERNAME=your-database-username
DB_PASSWORD=your-database-password
DB_POOL_SIZE=5

# AI API Configuration (OpenRouter)
AI_API_KEY=your-openrouter-api-key
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Service URLs (for production deployment)
USER_SERVICE_URL=http://localhost:9101
TICKET_SERVICE_URL=http://localhost:9102
CUSTOMER_SERVICE_URL=http://localhost:9103
ADMIN_SERVICE_URL=http://localhost:9104
EXECUTIVE_SERVICE_URL=http://localhost:9105

# Server Ports (optional, defaults are set)
# PORT=9100  # API Gateway
